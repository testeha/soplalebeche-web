---
import '../styles/global.css';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  transparentHeader?: boolean;
}

const {
  title,
  description = "Viajes y buenas historias con nombre de viento del sur",
  transparentHeader = false,
} = Astro.props;

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/historias', label: 'Historias' },
  { href: '/mapamundi', label: 'Mapamundi' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/contacto', label: 'Contacto' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} · Soplalebeche</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-crema-50 text-slate-800">
    <header
      id="site-header"
      data-transparent={transparentHeader ? 'true' : 'false'}
      class={`fixed top-0 inset-x-0 z-50 transition-colors duration-300 ${
        transparentHeader ? '' : 'bg-crema-50/95 backdrop-blur-sm border-b border-mediterraneo-800/10'
      }`}
    >
      <div class="max-w-6xl mx-auto px-6 py-5 grid items-center gap-4" style="grid-template-columns: 1fr auto 1fr;">
        {transparentHeader ? (
          <>
            <a href="/" class="justify-self-start"><Logo variant="white" /></a>
            <nav class="justify-self-center flex items-center gap-1 text-sm font-medium text-white border border-white/30 rounded-full px-2 py-2 backdrop-blur-sm">
              {navLinks.map((link) => (
                <a
                  href={link.href}
                  class={`px-4 py-2 rounded-full whitespace-nowrap transition-colors ${
                    isActive(link.href) ? 'bg-white text-mediterraneo-800' : 'hover:text-arena-100'
                  }`}
                >
                  {link.label}
                </a>
              ))}
            </nav>
            <a
              href="#"
              class="justify-self-end flex items-center gap-2 text-xs font-medium text-white border border-white/30 rounded-full px-4 py-2.5 hover:bg-white/10 whitespace-nowrap"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-white inline-block"></span>
              Un proyecto de Testeha Estudio
            </a>
          </>
        ) : (
          <>
            <a href="/" class="justify-self-start"><Logo /></a>
            <nav class="justify-self-center flex items-center gap-1 text-sm font-medium text-slate-700 border border-mediterraneo-800/15 rounded-full px-2 py-2">
              {navLinks.map((link) => (
                <a
                  href={link.href}
                  class={`px-4 py-2 rounded-full whitespace-nowrap transition-colors ${
                    isActive(link.href)
                      ? 'bg-mediterraneo-600 text-white'
                      : 'hover:text-mediterraneo-600'
                  }`}
                >
                  {link.label}
                </a>
              ))}
            </nav>
            <a
              href="#"
              class="justify-self-end flex items-center gap-2 text-xs font-medium text-mediterraneo-800 border border-mediterraneo-800/15 rounded-full px-4 py-2.5 hover:bg-mediterraneo-50 whitespace-nowrap"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-mediterraneo-800 inline-block"></span>
              Un proyecto de Testeha Estudio
            </a>
          </>
        )}
      </div>
    </header>

    <div id="page-content" class="max-w-6xl mx-auto px-6" style={transparentHeader ? '' : 'padding-top: 120px;'}>
      <main>
        <slot />
      </main>

      <footer class="bg-mediterraneo-800 rounded-3xl my-16 p-11">
        <div class="flex justify-between items-start gap-8 flex-wrap mb-6">
          <div>
            <Logo variant="dark" height={30} />
            <p class="text-white text-sm max-w-xs mt-3 leading-relaxed">
              2015-2021. Viajes y buenas historias con nombre de viento del sur. Un archivo personal de Rocío Periago. <a href="#" class="underline text-white hover:text-arena-100">Un proyecto de Testeha Estudio</a>.
            </p>
            <div class="flex items-center gap-3 mt-4">
              <a
                href="https://www.linkedin.com/in/rocioperiago"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn de Rocío Periago"
                class="w-8 h-8 rounded-full border border-white/25 flex items-center justify-center text-mediterraneo-100 hover:bg-white/10 hover:text-white transition-colors"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              <a
                href="https://instagram.com/rocioperiago"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram de Rocío Periago"
                class="w-8 h-8 rounded-full border border-white/25 flex items-center justify-center text-mediterraneo-100 hover:bg-white/10 hover:text-white transition-colors"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            </div>
          </div>
          <div class="flex flex-col gap-2 text-sm">
            <a href="/" class="text-mediterraneo-50 hover:text-white">Inicio</a>
            <a href="/historias" class="text-mediterraneo-50 hover:text-white">Historias</a>
            <a href="/mapamundi" class="text-mediterraneo-50 hover:text-white">Mapamundi</a>
            <a href="/sobre-mi" class="text-mediterraneo-50 hover:text-white">Sobre mí</a>
            <a href="/contacto" class="text-mediterraneo-50 hover:text-white">Contacto</a>
          </div>
          <div class="pl-1">
            <p class="text-white text-sm mb-3">Miembro de Madrid Travel Bloggers:</p>
            <a
              href="https://madridtb.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-white rounded-lg flex items-center justify-center hover:opacity-90 transition-opacity"
              style="width:140px; height:104px;"
            >
              <img
                src="https://www.soplalebeche.com/wp-content/uploads/2017/10/madtb_banner.png"
                alt="Asociación de blogueros de viajes de Madrid"
                class="max-w-[110px] max-h-[84px] w-auto h-auto object-contain"
              />
            </a>
          </div>
          <div class="pl-1">
            <p class="text-white text-sm mb-3">A los que buscamos Ítaca:</p>
            <a
              href="/a-los-que-buscamos-itaca"
              class="block rounded-lg overflow-hidden hover:opacity-90 transition-opacity"
              style="width:140px; height:104px;"
            >
              <img
                src="https://www.soplalebeche.com/wp-content/uploads/2017/10/201408_fisterre.jpg"
                alt="A los que buscamos Ítaca"
                class="w-full h-full object-cover"
              />
            </a>
          </div>
        </div>
        <div class="border-t border-white/15 pt-4 flex flex-wrap justify-between items-center gap-3 text-xs text-mediterraneo-200">
          <span>© 2026 Soplalebeche — Diseño y desarrollo web Testeha Estudio</span>
          <div class="flex gap-4">
            <a href="/aviso-legal" class="hover:text-white">Aviso Legal</a>
            <a href="/politica-privacidad" class="hover:text-white">Política de Privacidad</a>
            <a href="/politica-cookies" class="hover:text-white">Política de Cookies</a>
          </div>
        </div>
      </footer>
    </div>

    <div id="lightbox-overlay">
      <span class="lightbox-counter" id="lightbox-counter"></span>
      <span class="lightbox-close">&times;</span>
      <button class="lightbox-arrow prev" id="lightbox-prev" aria-label="Anterior">&#8249;</button>
      <img id="lightbox-image" src="" alt="" />
      <button class="lightbox-arrow next" id="lightbox-next" aria-label="Siguiente">&#8250;</button>
    </div>

    <button id="scroll-top-btn" class="scroll-top-btn" aria-label="Volver arriba">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>

    <div id="cookie-banner" class="cookie-banner">
      <p class="cookie-banner-text">
        Usamos cookies de análisis para entender cómo se usa esta web.
        Puedes aceptarlas o rechazarlas — no afecta a la navegación normal.
        <a href="/politica-cookies">Más información</a>.
      </p>
      <div class="cookie-banner-buttons">
        <button id="cookie-reject" class="cookie-btn cookie-btn-outline">Rechazar</button>
        <button id="cookie-accept" class="cookie-btn cookie-btn-solid">Aceptar</button>
      </div>
    </div>

    <script>
      // ---- Lightbox de galería ----
      const overlay = document.getElementById('lightbox-overlay');
      const overlayImg = document.getElementById('lightbox-image') as HTMLImageElement;
      const counter = document.getElementById('lightbox-counter');
      const btnPrev = document.getElementById('lightbox-prev');
      const btnNext = document.getElementById('lightbox-next');

      let currentGallery: HTMLImageElement[] = [];
      let currentIndex = 0;

      function showImage(index: number) {
        if (currentGallery.length === 0) return;
        currentIndex = (index + currentGallery.length) % currentGallery.length;
        const img = currentGallery[currentIndex];
        overlayImg.src = img.src;
        overlayImg.alt = img.alt;
        if (counter) {
          counter.textContent = currentGallery.length > 1
            ? `${currentIndex + 1} / ${currentGallery.length}`
            : '';
        }
        const showArrows = currentGallery.length > 1;
        if (btnPrev) btnPrev.style.display = showArrows ? 'flex' : 'none';
        if (btnNext) btnNext.style.display = showArrows ? 'flex' : 'none';
      }

      function openLightbox(clickedImg: HTMLImageElement, gallery: HTMLImageElement[]) {
        currentGallery = gallery;
        const index = gallery.indexOf(clickedImg);
        showImage(index === -1 ? 0 : index);
        overlay?.classList.add('active');
      }

      function closeLightbox() {
        overlay?.classList.remove('active');
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        const galleryContainer = target.closest('.gallery-grid');
        if (galleryContainer && target.tagName === 'IMG') {
          const gallery = Array.from(galleryContainer.querySelectorAll('img')) as HTMLImageElement[];
          openLightbox(target as HTMLImageElement, gallery);
          return;
        }

        if (target.id === 'lightbox-next') {
          showImage(currentIndex + 1);
          return;
        }
        if (target.id === 'lightbox-prev') {
          showImage(currentIndex - 1);
          return;
        }
        if (target.id === 'lightbox-overlay' || target.classList.contains('lightbox-close') || target.id === 'lightbox-image') {
          closeLightbox();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (!overlay?.classList.contains('active')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowRight') showImage(currentIndex + 1);
        if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
      });

      // ---- Parallax de imágenes destacadas (hero de Home y portada de cada crónica) ----
      function updateParallax() {
        const imgs = document.querySelectorAll<HTMLElement>('.parallax-img');
        const vh = window.innerHeight;
        imgs.forEach((img) => {
          const container = img.parentElement;
          if (!container) return;
          const rect = container.getBoundingClientRect();
          const center = rect.top + rect.height / 2 - vh / 2;
          const progress = center / (vh / 2 + rect.height / 2);
          const clamped = Math.max(-1, Math.min(1, progress));
          const maxShift = rect.height * 0.08;
          const shift = -clamped * maxShift;
          img.style.transform = `translateY(${shift}px)`;
        });
      }
      window.addEventListener('scroll', updateParallax, { passive: true });
      window.addEventListener('resize', updateParallax);
      updateParallax();

      // ---- Botón "volver arriba" ----
      const scrollTopBtn = document.getElementById('scroll-top-btn');
      function updateScrollTopBtn() {
        if (!scrollTopBtn) return;
        const cookieVisible = document.getElementById('cookie-banner')?.classList.contains('visible');
        if (window.scrollY > window.innerHeight * 0.6 && !cookieVisible) {
          scrollTopBtn.classList.add('visible');
        } else {
          scrollTopBtn.classList.remove('visible');
        }
      }
      scrollTopBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      window.addEventListener('scroll', updateScrollTopBtn, { passive: true });
      updateScrollTopBtn();

      // ---- Header fijo: en páginas con foto de portada, empieza transparente
      // sobre la imagen y se vuelve sólido en cuanto se avanza el scroll ----
      const siteHeader = document.getElementById('site-header');
      function updateHeaderBg() {
        if (!siteHeader || siteHeader.dataset.transparent !== 'true') return;
        if (window.scrollY > window.innerHeight * 0.55) {
          siteHeader.classList.add('bg-mediterraneo-800/95', 'backdrop-blur-sm', 'shadow-lg');
        } else {
          siteHeader.classList.remove('bg-mediterraneo-800/95', 'backdrop-blur-sm', 'shadow-lg');
        }
      }
      window.addEventListener('scroll', updateHeaderBg, { passive: true });
      updateHeaderBg();

      // ---- Banner de cookies + carga condicional de Google Analytics ----
      const GA_ID = 'G-77MX4PCXQT';

      function cargarGoogleAnalytics() {
        if (document.getElementById('ga-script')) return; // ya cargado
        const script1 = document.createElement('script');
        script1.id = 'ga-script';
        script1.async = true;
        script1.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.appendChild(script1);

        (window as any).dataLayer = (window as any).dataLayer || [];
        function gtag(...args: unknown[]) { (window as any).dataLayer.push(args); }
        gtag('js', new Date());
        gtag('config', GA_ID);
      }

      const cookieBanner = document.getElementById('cookie-banner');
      const consentimiento = localStorage.getItem('cookie-consent');

      if (consentimiento === 'aceptado') {
        cargarGoogleAnalytics();
      } else if (consentimiento !== 'rechazado') {
        cookieBanner?.classList.add('visible');
      }

      document.getElementById('cookie-accept')?.addEventListener('click', () => {
        localStorage.setItem('cookie-consent', 'aceptado');
        cookieBanner?.classList.remove('visible');
        cargarGoogleAnalytics();
        updateScrollTopBtn();
      });

      document.getElementById('cookie-reject')?.addEventListener('click', () => {
        localStorage.setItem('cookie-consent', 'rechazado');
        cookieBanner?.classList.remove('visible');
        updateScrollTopBtn();
      });

      // ---- Ajuste EXACTO del espacio bajo el header fijo ----
      // En vez de un número fijo a ojo, medimos la altura real del header
      // (puede variar ligeramente según fuente cargada o ancho de pantalla)
      // y se lo aplicamos como padding-top al contenido, solo en páginas sin
      // foto de portada (las de foto ya reservan su propio espacio con el hero).
      const pageContent = document.getElementById('page-content');
      function adjustContentPadding() {
        if (!siteHeader) return;
        const headerHeight = siteHeader.offsetHeight;
        // el margen de scroll para saltos de ancla hace falta en TODAS las páginas,
        // ya que el header fijo se vuelve sólido en cuanto avanzas el scroll
        document.documentElement.style.scrollPaddingTop = `${headerHeight + 16}px`;
        // el espacio inicial del contenido solo hace falta si el header no es
        // transparente (las páginas con foto ya reservan su propio espacio con el hero)
        if (!pageContent || siteHeader.dataset.transparent === 'true') return;
        pageContent.style.paddingTop = `${headerHeight + 32}px`;
      }
      window.addEventListener('resize', adjustContentPadding);
      document.addEventListener('DOMContentLoaded', adjustContentPadding);
      adjustContentPadding();
    </script>
  </body>
</html>
