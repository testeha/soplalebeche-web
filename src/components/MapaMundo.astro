---
import worldMapSvgRaw from '../data/world-map.svg?raw';
import { paises } from '../data/paises';
import { getCollection } from 'astro:content';

// Forzamos que el SVG "recorte" en vez de dejar huecos en blanco cuando el
// contenedor tiene una proporción distinta a la del propio mapa (así, en
// móvil, podemos hacerlo más alto sin que aparezcan franjas vacías).
const worldMapSvg = worldMapSvgRaw.replace('<svg', '<svg preserveAspectRatio="xMidYMid slice"');

const posts = await getCollection('posts', ({ data }) => !data.draft);

const pines = paises
  .map((pais) => {
    let matches = posts.filter((p) => (p.data.tags || []).includes(pais.nombre));
    matches = matches.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    let representative = matches[0];
    let count = matches.length;

    if (!representative && pais.fallbackSlug) {
      representative = posts.find((p) => p.data.slug === pais.fallbackSlug);
      count = representative ? 1 : 0;
    }

    return { ...pais, post: representative, count };
  })
  .filter((p) => p.post);
---

<div class="map-wrap">
  <Fragment set:html={worldMapSvg} />
  {pines.map((p) => (
    <button
      class="pin"
      style={`left:${p.left}%; top:${p.top}%;`}
      data-categoria={p.post!.data.categories[0]}
      data-pais={p.nombre}
      data-ciudad={p.ciudad || ''}
      data-titulo={p.post!.data.title}
      data-slug={p.post!.data.slug}
      aria-label={`Ver crónica de ${p.nombre}`}
    >
      <div class="pin-pulse"></div>
      <div class="pin-dot"></div>
      <div class="tooltip">
        <p class="cat">{p.post!.data.categories[0]} · {p.nombre}{p.ciudad ? ` · ${p.ciudad}` : ''}</p>
        <p class="titulo">{p.post!.data.title}</p>
        <a class="cta" href={`/historias/${p.post!.data.slug}`}>Leer crónica →</a>
      </div>
    </button>
  ))}
</div>

<!-- Tarjeta de información compartida: se rellena al tocar un pin (pensada para móvil, sin hover) -->
<div id="mapa-info-card" class="mapa-info-card hidden">
  <p id="mapa-info-cat" class="mapa-info-cat"></p>
  <p id="mapa-info-titulo" class="mapa-info-titulo"></p>
  <a id="mapa-info-cta" href="#" class="mapa-info-cta">Leer crónica →</a>
</div>

<script>
  const pins = document.querySelectorAll<HTMLButtonElement>('.pin');
  const card = document.getElementById('mapa-info-card');
  const cardCat = document.getElementById('mapa-info-cat');
  const cardTitulo = document.getElementById('mapa-info-titulo');
  const cardCta = document.getElementById('mapa-info-cta') as HTMLAnchorElement;

  pins.forEach((pin) => {
    pin.addEventListener('click', (e) => {
      // Si el clic viene del propio enlace "Leer crónica" del tooltip, dejar que navegue con normalidad
      if ((e.target as HTMLElement).closest('.cta')) return;

      e.preventDefault();
      const { categoria, pais, ciudad, titulo, slug } = pin.dataset;
      if (cardCat) cardCat.textContent = `${categoria} · ${pais}${ciudad ? ` · ${ciudad}` : ''}`;
      if (cardTitulo) cardTitulo.textContent = titulo || '';
      if (cardCta) cardCta.href = `/historias/${slug}`;
      card?.classList.remove('hidden');
      card?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>
