---
interface Props {
  variant?: 'light' | 'dark' | 'white';
  height?: number;
}
const { variant = 'light', height = 34 } = Astro.props;

// light -> fondo crema (header normal): colores de marca
// dark  -> fondo azul sólido (footer): blanco + toques de color, controlado
// white -> sobre foto (hero de la Home): todo blanco, máximo contraste garantizado
let strokeColors: string[];
let textColor: string;
let italicColor: string;

if (variant === 'white') {
  strokeColors = ['#FFFFFF', 'rgba(255,255,255,0.75)', 'rgba(255,255,255,0.55)'];
  textColor = '#FFFFFF';
  italicColor = '#FFFFFF';
} else if (variant === 'dark') {
  strokeColors = ['#85B7EB', '#B5D4F4', '#FAC775'];
  textColor = '#FFFFFF';
  italicColor = '#B5D4F4';
} else {
  strokeColors = ['#185FA5', '#378ADD', '#FAC775'];
  textColor = '#0C447C';
  italicColor = '#185FA5';
}
---

<svg width={height * 5.8} height={height} viewBox="0 0 340 60" xmlns="http://www.w3.org/2000/svg">
  <path d="M4 20 Q22 8 40 20 T74 20" stroke={strokeColors[0]} stroke-width="3.2" stroke-linecap="round" fill="none"/>
  <path d="M4 32 Q18 24 32 32 T58 32" stroke={strokeColors[1]} stroke-width="3.2" stroke-linecap="round" fill="none"/>
  <path d="M4 44 Q14 39 24 44" stroke={strokeColors[2]} stroke-width="3.2" stroke-linecap="round" fill="none"/>
  <text x="90" y="40" font-family="Newsreader, Georgia, serif" font-size="32" fill={textColor}>Sopla<tspan font-style="italic" fill={italicColor}>lebeche</tspan></text>
</svg>
