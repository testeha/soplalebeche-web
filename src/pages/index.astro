---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

function slugify(str: string) {
  return str
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, '-');
}

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latest = posts[0];
const recent = posts.slice(1, 4);

const categoryCounts: Record<string, number> = {};
const categoryImages: Record<string, string> = {};
posts.forEach((post) => {
  post.data.categories.forEach((cat) => {
    categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
    if (!categoryImages[cat] && post.data.featuredImage) {
      categoryImages[cat] = post.data.featuredImage;
    }
  });
});
const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);

// Filas de la sección "Explora por tema": 2 / 3 / 3 / 4 categorías por fila.
// Es una prueba pensada para las 12 categorías actuales — si el número de
// categorías cambia bastante en el futuro, hay que revisar este reparto.
const fila1 = categories.slice(0, 2);
const fila2 = categories.slice(2, 5);
const fila3 = categories.slice(5, 8);
const fila4 = categories.slice(8, 12);

const catColors: Record<string, string> = {
  'Viajes': 'from-mediterraneo-600 to-mediterraneo-200',
  'Europa': 'from-mediterraneo-800 to-mediterraneo-400',
  'Periodismo Social': 'from-oscuro-100 to-terracota-100',
  'Cuadernos de Viaje': 'from-verde-800 to-verde-400',
  'Mujeres': 'from-terracota-800 to-terracota-100',
  'África': 'from-terracota-800 to-terracota-100',
  'Fotografía': 'from-slate-900 to-slate-700',
};
---

<Layout title="Inicio" transparentHeader={true}>
  <div class="relative left-1/2 -translate-x-1/2 w-screen overflow-hidden" style="height: 100vh;">
    {latest.data.featuredImage ? (
      <img src={latest.data.featuredImage} alt={latest.data.title} class="parallax-img" />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-mediterraneo-900 via-mediterraneo-600 to-mediterraneo-200"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-mediterraneo-900/90 via-mediterraneo-900/20 to-mediterraneo-900/45"></div>
    <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/45 to-transparent"></div>

    <div class="absolute inset-0 flex items-end">
      <div class="max-w-6xl mx-auto px-6 w-full pb-24">
        <div class="max-w-xl">
          <p class="text-xs font-bold uppercase tracking-wider text-arena-100 mb-3">
            Última crónica · {latest.data.categories[0]}
          </p>
          <h2 class="font-voice text-4xl text-white mb-3 leading-tight">
            {latest.data.title}
          </h2>
          {latest.data.excerpt && (
            <p class="text-white text-sm mb-5 leading-relaxed">{latest.data.excerpt}</p>
          )}
          <p class="text-white text-sm mb-6">
            {latest.data.author} · {new Date(latest.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
          <a
            href={`/historias/${latest.data.slug}`}
            class="inline-block bg-white text-mediterraneo-800 text-sm font-semibold px-6 py-3 rounded-full hover:bg-arena-50"
          >
            Leer crónica →
          </a>
        </div>
      </div>
    </div>

    <a
      href="#inicio-contenido"
      class="absolute bottom-8 left-1/2 -translate-x-1/2 w-11 h-11 rounded-full border border-white/40 backdrop-blur-sm flex items-center justify-center text-white hover:bg-white/10 transition-colors"
      aria-label="Ir al contenido"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M19 12l-7 7-7-7" />
      </svg>
    </a>
  </div>

  <section id="inicio-contenido" class="pt-10 mb-14 max-w-2xl mx-auto text-center">
    <h1 class="font-voice text-4xl text-mediterraneo-800 mb-3">Sopla<em class="italic text-mediterraneo-600">lebeche</em></h1>
    <p class="text-slate-600 text-lg leading-relaxed">
      Un blog de viajes, periodismo, fotografía, compromiso y responsabilidad social. Buenas historias con nombre de viento del Sur.
    </p>
  </section>

  <section id="ultimas-cronicas" class="mb-14">
    <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-3 mb-6">
      <div>
        <h2 class="font-voice text-3xl text-mediterraneo-800 mb-2">Últimas crónicas</h2>
        <p class="text-slate-600 text-sm">Lo más reciente del archivo</p>
      </div>
      <a href="/historias" class="text-sm font-semibold text-mediterraneo-600">Ver todas las historias →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {recent.map((post) => (
        <a href={`/historias/${post.data.slug}`} class="bg-white border border-mediterraneo-800/10 rounded-2xl overflow-hidden">
          {post.data.featuredImage ? (
            <img src={post.data.featuredImage} alt={post.data.title} class="w-full aspect-[4/3] object-cover" loading="lazy" />
          ) : (
            <div class={`aspect-[4/3] bg-gradient-to-br ${catColors[post.data.categories[0]] || 'from-mediterraneo-600 to-mediterraneo-200'}`}></div>
          )}
          <div class="p-5">
            <p class="text-[10.5px] font-bold uppercase tracking-wide text-mediterraneo-600 mb-2">{post.data.categories[0]}</p>
            <h3 class="font-voice text-[1.4rem] font-medium mb-3 leading-snug">{post.data.title}</h3>
            <div class="w-8 h-0.5 bg-arena-100 mb-3"></div>
            <p class="text-xs text-[#1d293d]">
              {new Date(post.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-14">
    <h2 class="font-voice text-3xl text-mediterraneo-800 mb-2">Explora por tema</h2>
    <p class="text-slate-600 text-sm mb-6">Años de crónicas organizadas por lo que de verdad importa: personas, lugares y causas.</p>

    <div class="space-y-4">
      <div class="grid grid-cols-2 gap-4 h-[180px] md:h-[260px]">
        {fila1.map(([cat, count]) => (
          <a href={`/historias/categoria/${slugify(cat)}`} class="relative rounded-2xl overflow-hidden flex items-end">
            {categoryImages[cat] ? (
              <img src={categoryImages[cat]} alt={cat} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            ) : (
              <div class={`absolute inset-0 bg-gradient-to-br ${catColors[cat] || 'from-mediterraneo-600 to-mediterraneo-200'}`}></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            <span class="relative z-10 p-4 font-voice text-white text-lg">{cat}</span>
            <span class="absolute top-3.5 right-3.5 z-10 text-[10px] font-bold text-mediterraneo-800 bg-white px-2.5 py-1 rounded-full">{count} historias</span>
          </a>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 h-[180px] md:h-[170px]">
        {fila2.map(([cat, count]) => (
          <a href={`/historias/categoria/${slugify(cat)}`} class="relative rounded-2xl overflow-hidden flex items-end">
            {categoryImages[cat] ? (
              <img src={categoryImages[cat]} alt={cat} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            ) : (
              <div class={`absolute inset-0 bg-gradient-to-br ${catColors[cat] || 'from-mediterraneo-600 to-mediterraneo-200'}`}></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            <span class="relative z-10 p-4 font-voice text-white text-lg">{cat}</span>
            <span class="absolute top-3.5 right-3.5 z-10 text-[10px] font-bold text-mediterraneo-800 bg-white px-2.5 py-1 rounded-full">{count} historias</span>
          </a>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 h-[180px] md:h-[170px]">
        {fila3.map(([cat, count]) => (
          <a href={`/historias/categoria/${slugify(cat)}`} class="relative rounded-2xl overflow-hidden flex items-end">
            {categoryImages[cat] ? (
              <img src={categoryImages[cat]} alt={cat} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            ) : (
              <div class={`absolute inset-0 bg-gradient-to-br ${catColors[cat] || 'from-mediterraneo-600 to-mediterraneo-200'}`}></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            <span class="relative z-10 p-4 font-voice text-white text-lg">{cat}</span>
            <span class="absolute top-3.5 right-3.5 z-10 text-[10px] font-bold text-mediterraneo-800 bg-white px-2.5 py-1 rounded-full">{count} historias</span>
          </a>
        ))}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 h-[180px] md:h-[150px]">
        {fila4.map(([cat, count]) => (
          <a href={`/historias/categoria/${slugify(cat)}`} class="relative rounded-2xl overflow-hidden flex items-end">
            {categoryImages[cat] ? (
              <img src={categoryImages[cat]} alt={cat} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            ) : (
              <div class={`absolute inset-0 bg-gradient-to-br ${catColors[cat] || 'from-mediterraneo-600 to-mediterraneo-200'}`}></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            <span class="relative z-10 p-4 font-voice text-white text-lg">{cat}</span>
            <span class="absolute top-3.5 right-3.5 z-10 text-[10px] font-bold text-mediterraneo-800 bg-white px-2.5 py-1 rounded-full">{count} historias</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
