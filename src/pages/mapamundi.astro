---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import MapaMundo from '../components/MapaMundo.astro';

const pages = await getCollection('pages');
const page = pages.find((p) => p.data.slug === 'viajes-mapamundi-destinos');
const { Content } = await render(page);
---

<Layout title="Mapamundi">
  <h1 class="font-voice text-3xl md:text-4xl text-mediterraneo-800 mb-4 md:mb-8">Mapamundi</h1>
  <div class="mb-5 md:mb-8">
    <MapaMundo />
  </div>
  <div class="max-w-2xl mx-auto article-body font-voice text-base md:text-lg leading-relaxed text-slate-800 prose-blockquote:border-l-2 prose-blockquote:border-mediterraneo-400 prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:text-mediterraneo-800 space-y-4 md:space-y-6">
    <Content />
  </div>
</Layout>
