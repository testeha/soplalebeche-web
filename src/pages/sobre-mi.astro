---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const page = pages.find((p) => p.data.slug === 'sobre-mi');
const { Content } = await render(page);
---

<Layout title="Sobre mí">
  <article class="max-w-2xl mx-auto">
    <div class="w-22 h-22 rounded-full bg-gradient-to-br from-mediterraneo-200 to-mediterraneo-600 mb-6" style="width: 88px; height: 88px;"></div>
    <h1 class="font-voice text-4xl text-mediterraneo-800 mb-8">Sobre mí</h1>
    <div class="article-body font-voice text-lg leading-relaxed text-slate-800 prose-blockquote:border-l-2 prose-blockquote:border-mediterraneo-400 prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:text-mediterraneo-800 space-y-6">
      <Content />
    </div>
  </article>
</Layout>