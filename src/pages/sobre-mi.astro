---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const page = pages.find((p) => p.data.slug === 'sobre-mi');
const { Content } = await render(page);
---

<Layout title="Sobre mí" description="Me llamo Rocío Periago, y soy la autora de este blog. Viajera y curiosa, me encanta conocer otras culturas, hablar con la gente y contar historias.">
  <h1 class="font-voice text-4xl text-mediterraneo-800 mb-8">Sobre mí</h1>

  <figure class="mb-10">
    <img
      src="https://www.soplalebeche.com/wp-content/uploads/2016/07/sobremi_rocioperiago_soplalebeche.png"
      alt="Rocío Periago"
      class="w-full rounded-3xl object-cover"
      style="aspect-ratio: 21/9;"
    />
    <figcaption class="text-xs text-slate-400 mt-2">Terreros (Almería) © Rocío Periago</figcaption>
  </figure>

  <div class="grid md:grid-cols-[1fr_220px] gap-12">
    <div class="article-body font-voice text-lg leading-relaxed text-slate-800 space-y-6 max-w-2xl">
      <Content />
    </div>

    <aside class="md:sticky md:top-32 self-start flex flex-col items-center md:items-start text-center md:text-left">
      <img
        src="https://www.soplalebeche.com/wp-content/uploads/2016/07/cropped-sobremi_rocioperiago_soplalebeche-270x270.png"
        alt="Rocío Periago"
        class="w-28 h-28 rounded-full object-cover mb-4"
      />
      <p class="font-voice text-lg text-mediterraneo-800 mb-1">Rocío Periago</p>
      <p class="text-xs text-slate-400 mb-4">Autora de Soplalebeche</p>
      <div class="flex items-center gap-3">
        <a
          href="https://www.linkedin.com/in/rocioperiago"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn de Rocío Periago"
          class="w-9 h-9 rounded-full border border-mediterraneo-800/15 flex items-center justify-center text-mediterraneo-600 hover:bg-mediterraneo-50 transition-colors"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href="https://instagram.com/rocioperiago"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de Rocío Periago"
          class="w-9 h-9 rounded-full border border-mediterraneo-800/15 flex items-center justify-center text-mediterraneo-600 hover:bg-mediterraneo-50 transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      </div>
    </aside>
  </div>
</Layout>
