---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto" description="Escríbeme si quieres proponer algo, compartir tu historia o simplemente saludar.">
  <h1 class="font-voice text-3xl md:text-4xl text-mediterraneo-800 mb-4 md:mb-8">Contacto</h1>

  <img
    src="/images/paginas/20160808_slide.webp"
    alt="Contacto"
    class="w-full rounded-3xl object-cover mb-6 md:mb-14 aspect-[4/3] md:aspect-[21/9]"
  />

  <div class="grid md:grid-cols-2 gap-10 md:gap-16">
    <div>
      <h2 class="font-voice text-2xl md:text-4xl text-mediterraneo-800 mb-3 leading-tight">¿Tienes una historia que contar?</h2>
      <div class="w-10 h-0.5 bg-arena-100 mb-4 md:mb-6"></div>
      <p class="text-slate-700 mb-4 leading-relaxed">
        Una propuesta de colaboración, una idea o simplemente te apetece saludar.
      </p>
      <p class="text-slate-700 mb-8 leading-relaxed">
        Escríbeme. Leo todos los mensajes y siempre contesto.
      </p>

      <div class="border-t border-mediterraneo-800/10 pt-8 mb-8">
        <div class="flex items-center gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-mediterraneo-600 flex-shrink-0">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          <div>
            <p class="text-sm text-slate-600">También puedes escribirme a</p>
            <a href="mailto:hola@testeha.com" class="font-semibold text-mediterraneo-800 hover:text-mediterraneo-600">hola@testeha.com →</a>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://www.linkedin.com/in/rocioperiago"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn de Rocío Periago"
          class="w-9 h-9 rounded-full border border-mediterraneo-800/15 flex items-center justify-center text-mediterraneo-600 hover:bg-mediterraneo-50 transition-colors"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href="https://instagram.com/rocioperiago"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram de Rocío Periago"
          class="w-9 h-9 rounded-full border border-mediterraneo-800/15 flex items-center justify-center text-mediterraneo-600 hover:bg-mediterraneo-50 transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      </div>
    </div>

    <div>
      <h2 class="font-voice text-4xl text-mediterraneo-800 mb-3">Escríbeme</h2>
      <div class="w-10 h-0.5 bg-arena-100 mb-8"></div>

      <form id="contact-form" action="https://formspree.io/f/xdeonwkd" method="POST" class="space-y-6">
        <input type="hidden" name="_subject" value="Nuevo mensaje desde Soplalebeche" />
        <div>
          <label for="nombre" class="block text-sm font-semibold text-mediterraneo-800 mb-2">
            Nombre <span class="text-arena-400">*</span>
          </label>
          <input
            type="text" id="nombre" name="nombre" required
            placeholder="Tu nombre"
            class="w-full border border-mediterraneo-800/20 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-mediterraneo-600"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-semibold text-mediterraneo-800 mb-2">
            Email <span class="text-arena-400">*</span>
          </label>
          <input
            type="email" id="email" name="email" required
            placeholder="tu@email.com"
            class="w-full border border-mediterraneo-800/20 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-mediterraneo-600"
          />
        </div>

        <div>
          <p class="block text-sm font-semibold text-mediterraneo-800 mb-2">
            ¿Sobre qué quieres hablar? <span class="text-arena-400">*</span>
          </p>
          <div class="grid grid-cols-3 gap-3">
            <label class="topic-option">
              <input type="radio" name="asunto" value="Una historia" checked />
              <span class="topic-card">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                Una historia
              </span>
            </label>
            <label class="topic-option">
              <input type="radio" name="asunto" value="Colaboración" />
              <span class="topic-card">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3 1 11h-2"/><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"/><path d="M3 4h8"/></svg>
                Colaboración
              </span>
            </label>
            <label class="topic-option">
              <input type="radio" name="asunto" value="Simplemente saludar" />
              <span class="topic-card">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                Simplemente saludar
              </span>
            </label>
          </div>
        </div>

        <div>
          <label for="mensaje" class="block text-sm font-semibold text-mediterraneo-800 mb-2">
            Mensaje <span class="text-arena-400">*</span>
          </label>
          <textarea
            id="mensaje" name="mensaje" required rows="5"
            placeholder="Cuéntame en qué puedo ayudarte..."
            class="w-full border border-mediterraneo-800/20 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-mediterraneo-600 resize-none"
          ></textarea>
        </div>

        <label class="flex items-start gap-2.5 text-sm text-slate-600">
          <input type="checkbox" required class="mt-0.5" />
          He leído y acepto la <a href="/politica-privacidad" class="text-mediterraneo-600 underline hover:text-mediterraneo-800">política de privacidad</a>
        </label>

        <button
          id="contact-submit"
          type="submit"
          class="inline-flex items-center gap-2 bg-mediterraneo-800 text-white font-semibold px-7 py-3.5 rounded-xl hover:bg-mediterraneo-600 transition-colors disabled:opacity-60"
        >
          Enviar mensaje →
        </button>
        <p id="contact-error" class="text-sm text-terracota-800 hidden">
          Algo ha fallado al enviar el mensaje. Prueba de nuevo, o escríbeme directamente a
          <a href="mailto:hola@testeha.com" class="underline">hola@testeha.com</a>.
        </p>

        <p class="text-xs text-slate-400">* Campos obligatorios</p>
      </form>
    </div>
  </div>

  <style>
    .topic-option { cursor: pointer; }
    .topic-option input { position: absolute; opacity: 0; pointer-events: none; }
    .topic-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      text-align: center;
      font-family: 'Inter', sans-serif;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--color-slate-600);
      border: 1.5px solid var(--color-mediterraneo-800);
      border-color: rgba(12, 68, 124, 0.15);
      border-radius: 12px;
      padding: 16px 8px;
      transition: border-color .15s ease, background .15s ease;
    }
    .topic-option input:checked + .topic-card {
      border-color: var(--color-mediterraneo-600);
      background: var(--color-mediterraneo-50);
      color: var(--color-mediterraneo-800);
    }
  </style>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
    const errorMsg = document.getElementById('contact-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg?.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          window.location.href = '/gracias';
        } else {
          throw new Error('Formspree respondió con error');
        }
      } catch (err) {
        errorMsg?.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar mensaje →';
      }
    });
  </script>
</Layout>
