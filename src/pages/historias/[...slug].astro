---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

function slugify(str: string) {
  return str
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, '-');
}

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const catColors: Record<string, string> = {
  'Viajes': 'from-mediterraneo-600 to-mediterraneo-200',
  'Europa': 'from-mediterraneo-800 to-mediterraneo-400',
  'Periodismo Social': 'from-oscuro-100 to-terracota-100',
  'Cuadernos de Viaje': 'from-verde-800 to-verde-400',
  'Mujeres': 'from-terracota-800 to-terracota-100',
  'África': 'from-terracota-800 to-terracota-100',
  'Fotografía': 'from-slate-900 to-slate-700',
};

// artículos relacionados: mismo categoría primero, completando con los más recientes si faltan
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sameCategory = allPosts
  .filter((p) => p.data.slug !== post.data.slug)
  .filter((p) => p.data.categories.some((c) => post.data.categories.includes(c)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const related = [...sameCategory];
if (related.length < 2) {
  const usedSlugs = new Set([post.data.slug, ...related.map((p) => p.data.slug)]);
  const extra = allPosts
    .filter((p) => !usedSlugs.has(p.data.slug))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  related.push(...extra);
}
const relatedPosts = related.slice(0, 2);
---

<Layout title={post.data.title} description={post.data.excerpt}>
  <article class="max-w-2xl mx-auto">
    {post.data.featuredImage && (
      <img
        src={post.data.featuredImage}
        alt={post.data.title}
        class="w-full aspect-[16/8] object-cover rounded-3xl mb-8"
      />
    )}

    <p class="text-xs font-bold uppercase tracking-wider text-mediterraneo-600 mb-3">
      {post.data.categories.join(' · ')}
    </p>
    <h1 class="font-voice text-4xl text-mediterraneo-800 mb-3 leading-tight">
      {post.data.title}
    </h1>
    <p class="text-sm text-slate-400 mb-10">
      {post.data.author} · {new Date(post.data.pubDate).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
    </p>

    <div class="article-body font-voice text-lg leading-relaxed text-slate-800 prose-blockquote:border-l-2 prose-blockquote:border-mediterraneo-400 prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:text-mediterraneo-800 space-y-6">
      <Content />
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-10 pt-8 border-t border-mediterraneo-800/10">
        {post.data.tags.map((tag: string) => (
          <a
            href={`/historias/etiqueta/${slugify(tag)}`}
            class="text-xs bg-arena-50 text-arena-400 px-3 py-1.5 rounded-full hover:bg-arena-100"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    {post.data.comments && post.data.comments.length > 0 && (
      <div class="mt-10 border-t border-mediterraneo-800/10 pt-8">
        <h2 class="font-voice text-2xl text-mediterraneo-800 mb-6">Comentarios</h2>
        {post.data.comments.map((comment) => (
          <div class="bg-arena-50 rounded-2xl p-5 mb-4">
            <p class="font-semibold text-sm text-[#412402]">{comment.author}</p>
            <p class="text-xs text-arena-400 mb-2">
              {new Date(comment.date).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
            </p>
            <p class="text-sm text-[#412402]" set:html={comment.content} />
          </div>
        ))}
      </div>
    )}

    {relatedPosts.length > 0 && (
      <div class="mt-14 pt-10 border-t border-mediterraneo-800/10">
        <h2 class="font-voice text-2xl text-mediterraneo-800 mb-6">Artículos relacionados</h2>
        <div class="grid grid-cols-2 gap-5">
          {relatedPosts.map((rp) => (
            <a href={`/historias/${rp.data.slug}`} class="bg-white border border-mediterraneo-800/10 rounded-2xl overflow-hidden">
              {rp.data.featuredImage ? (
                <img src={rp.data.featuredImage} alt={rp.data.title} class="w-full aspect-[4/3] object-cover" loading="lazy" />
              ) : (
                <div class={`aspect-[4/3] bg-gradient-to-br ${catColors[rp.data.categories[0]] || 'from-mediterraneo-600 to-mediterraneo-200'}`}></div>
              )}
              <div class="p-4">
                <p class="text-[10.5px] font-bold uppercase tracking-wide text-mediterraneo-600 mb-1.5">{rp.data.categories[0]}</p>
                <h3 class="font-voice text-base leading-snug">{rp.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>
</Layout>