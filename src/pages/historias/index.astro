---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const catColors: Record<string, string> = {
  'Viajes': 'from-mediterraneo-600 to-mediterraneo-200',
  'Europa': 'from-mediterraneo-800 to-mediterraneo-400',
  'Periodismo Social': 'from-oscuro-100 to-terracota-100',
  'Cuadernos de Viaje': 'from-verde-800 to-verde-400',
  'Mujeres': 'from-terracota-800 to-terracota-100',
  'África': 'from-terracota-800 to-terracota-100',
  'Fotografía': 'from-slate-900 to-slate-700',
};

const fecha = (d: Date) =>
  new Date(d).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });

// Agrupamos los posts en ciclos de 5: los 3 primeros van en una fila de
// columnas iguales, los 2 siguientes en una fila destacada (2/3 + 1/3).
type Bloque = { tipo: 'iguales' | 'destacada'; items: typeof posts };
const bloques: Bloque[] = [];
for (let i = 0; i < posts.length; i += 5) {
  const grupo = posts.slice(i, i + 5);
  if (grupo.length > 0) bloques.push({ tipo: 'iguales', items: grupo.slice(0, 3) });
  if (grupo.length > 3) bloques.push({ tipo: 'destacada', items: grupo.slice(3, 5) });
}

const PRIMER_LOTE = 3; // nº de bloques visibles al cargar (3 bloques ≈ 15 crónicas)
---

<Layout title="Historias" description={`${posts.length} crónicas de viaje, personas y lugares, publicadas desde 2015.`}>
  <p class="text-xs font-bold uppercase tracking-wider text-arena-400 mb-3">Archivo</p>
  <h1 class="font-voice text-4xl text-mediterraneo-800 mb-3">Historias</h1>
  <p class="text-slate-600 mb-10">{posts.length} crónicas de viaje, personas y lugares, publicadas desde 2015.</p>

  <div class="space-y-5">
    {bloques.map((bloque, i) => (
      <div class:list={['bloque-historias', i >= PRIMER_LOTE && 'hidden']} data-bloque={i}>
        {bloque.tipo === 'iguales' ? (
          <div class="grid grid-cols-3 gap-5">
            {bloque.items.map((post) => (
              <a href={`/historias/${post.data.slug}`} class="relative rounded-2xl overflow-hidden flex items-end" style="aspect-ratio: 4/3.1;">
                {post.data.featuredImage ? (
                  <img src={post.data.featuredImage} alt={post.data.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class={`absolute inset-0 bg-gradient-to-br ${catColors[post.data.categories[0]] || 'from-mediterraneo-600 to-mediterraneo-200'}`}></div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/15 to-transparent"></div>
                <div class="relative z-10 p-5">
                  <p class="text-[10.5px] font-bold uppercase tracking-wide text-arena-100 mb-1.5">{post.data.categories[0]}</p>
                  <h3 class="font-voice text-[1.4rem] font-medium text-white mb-1.5 leading-snug">{post.data.title}</h3>
                  <p class="text-xs text-white/80">{fecha(post.data.pubDate)}</p>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="grid grid-cols-3 gap-5">
            {bloque.items.map((post, idx) => (
              <a
                href={`/historias/${post.data.slug}`}
                class={`relative rounded-2xl overflow-hidden flex items-end ${idx === 0 ? 'col-span-2' : 'col-span-1'}`}
                style="aspect-ratio: 4/3.1;"
              >
                {post.data.featuredImage ? (
                  <img src={post.data.featuredImage} alt={post.data.title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                ) : (
                  <div class={`absolute inset-0 bg-gradient-to-br ${catColors[post.data.categories[0]] || 'from-mediterraneo-600 to-mediterraneo-200'}`}></div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/15 to-transparent"></div>
                <div class="relative z-10 p-6">
                  <p class="text-[10.5px] font-bold uppercase tracking-wide text-arena-100 mb-2">{post.data.categories[0]}</p>
                  <h3 class={`font-voice font-medium text-white mb-2 leading-snug ${idx === 0 ? 'text-[1.9rem]' : 'text-[1.4rem]'}`}>{post.data.title}</h3>
                  <p class="text-xs text-white/80">{fecha(post.data.pubDate)}</p>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>

  {bloques.length > PRIMER_LOTE && (
    <div class="text-center mt-10">
      <button
        id="cargar-mas"
        class="inline-flex items-center gap-2 border border-mediterraneo-800/20 text-mediterraneo-800 text-sm font-semibold px-6 py-3 rounded-full hover:bg-mediterraneo-50 transition-colors"
        data-total-bloques={bloques.length}
        data-visibles={PRIMER_LOTE}
      >
        Cargar más historias
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M19 12l-7 7-7-7" />
        </svg>
      </button>
    </div>
  )}

  <script>
    const btn = document.getElementById('cargar-mas');
    btn?.addEventListener('click', () => {
      const total = parseInt(btn.dataset.totalBloques || '0', 10);
      let visibles = parseInt(btn.dataset.visibles || '0', 10);
      const siguienteLote = visibles + 3;
      for (let i = visibles; i < Math.min(siguienteLote, total); i++) {
        document.querySelector(`[data-bloque="${i}"]`)?.classList.remove('hidden');
      }
      visibles = Math.min(siguienteLote, total);
      btn.dataset.visibles = String(visibles);
      if (visibles >= total) {
        btn.style.display = 'none';
      }
    });
  </script>
</Layout>
